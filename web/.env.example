# Copy to .env.local. The publishable key is safe for the browser.
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=<publishable key>
# Never put the service-role key or LLM provider keys in NEXT_PUBLIC_ variables.

# Sign-in is off unless this is true.
NEXT_PUBLIC_AUTH_ENABLED=false
